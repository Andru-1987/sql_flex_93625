# Cadena de conexión a la base de datos del curso (createdb curso_pg_moderno)
DATABASE_URL=postgresql://usuario:password@localhost:5432/curso_pg_moderno

# --- Autenticación con Gemini API (Google AI Studio) ---
# Alcanza con UNA de las dos (GEMINI_API_KEY tiene prioridad si están ambas).
# Se genera gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Alternativa: Vertex AI (si preferís usar tu proyecto GCP en vez de la API key) ---
# Descomentar estas 3 y dejar GEMINI_API_KEY vacía para que el cliente use Vertex AI.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Configuración opcional del loader ---
EMBEDDING_BATCH_LIMIT=50
RATE_LIMIT_SLEEP_SECONDS=1.0
LOG_LEVEL=INFO
